<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Тонкий оконно-невидимый лаунчер для Планировщика заданий Windows.
    OutputType=WinExe => GUI-подсистема: Планировщик не создаёт для него консоль.
    Сам лаунчер запускает консольный AgentNotify.exe с CreateNoWindow, поэтому окно
    терминала не появляется ни на одном этапе.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AgentNotify.Launcher</AssemblyName>
    <RootNamespace>AgentNotify.Launcher</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentNotify.Tests" />
  </ItemGroup>

</Project>
